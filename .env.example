# Archivo de ejemplo de configuración de entorno
# Copia este archivo como .env.local y configura tus propias credenciales

APP_ENV=dev
###> doctrine/mongodb-odm-bundle ###
# Reemplaza con tus credenciales reales de MongoDB Atlas:
# - usuario: tu nombre de usuario de MongoDB
# - password: tu contraseña de MongoDB
# - cluster: nombre de tu cluster en MongoDB Atlas
# - bookshop: nombre de tu base de datos
MONGODB_URL=mongodb+srv://enewolff2014:4VMJj9aSy22a2Se3@cluster0.zlismj0.mongodb.net/bookshop?retryWrites=true&w=majority
MONGODB_DATABASE=sistema_ofertas
###< doctrine/mongodb-odm-bundle ###

APP_DEBUG=true
APP_TIMEZONE=America/Bogota
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=pdf,zip
BASE_URL=http://localhost:8000